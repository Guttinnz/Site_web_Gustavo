{
  "name": "portfolio-gustavo-bueno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/images.mjs",
    "dev": "vite",
    "prebuild": "node scripts/images.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "images": "node scripts/images.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "preview:test": "vite preview --port 4173 --strictPort",
    "cy:open": "cypress open --e2e --browser chrome",
    "cy:open:mobile": "cypress open --e2e --browser chrome --expose device=mobile",
    "test:web": "cypress run --browser chrome --expose device=web",
    "test:mobile": "cypress run --browser chrome --expose device=mobile",
    "test:all": "npm run test:web && npm run test:mobile",
    "test:e2e": "start-server-and-test preview:test http://localhost:4173 test:all",
    "test:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "qa:report": "node scripts/qa-report.mjs",
    "qa": "npm run build && npm run test:e2e && npm run test:lighthouse && npm run qa:report && npm run build"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^9.39.5",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "cypress": "^16.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "cypress": true,
    "esbuild": true
  }
}
