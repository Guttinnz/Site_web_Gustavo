# URL pública do site (canonical, Open Graph, JSON-LD, sitemap e robots.txt).
# Opcional na Vercel: sem ela, o build usa o domínio de produção do projeto
# (VERCEL_PROJECT_PRODUCTION_URL). Defina quando tiver domínio próprio.
SITE_URL=https://gustavo-bueno.vercel.app

# --- Formulário de contato (api/contact.ts) ---------------------------------
# Chave do Resend (https://resend.com → API Keys). Fica SÓ no servidor: configure
# em Vercel → Settings → Environment Variables. Localmente, copie para .env.local
# se quiser testar o envio de verdade — sem ela, o `npm run dev` apenas mostra a
# mensagem no terminal.
RESEND_API_KEY=

# Opcionais:
# CONTACT_TO_EMAIL=gustavoriedel2202@gmail.com
# CONTACT_FROM_EMAIL=Portfólio Gustavo Bueno <onboarding@resend.dev>
